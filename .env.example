# --- Google Sheets ---
# サービスアカウントの JSON ファイルパス（ローカル実行時）
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json
# スプレッドシートのID（URL の /d/ と /edit の間）
SPREADSHEET_ID=your_spreadsheet_id_here
WORKSHEET_NAME=posts

# --- Gemini 2.5 Flash ---
# https://aistudio.google.com/app/apikey で発行
GEMINI_API_KEY=your_gemini_api_key_here

# --- Groq (Gemini 503 時のフォールバック) ---
# https://console.groq.com/keys で発行（完全無料）
GROQ_API_KEY=your_groq_api_key_here

# --- Cloudinary（無料枠）---
# https://cloudinary.com/console の Dashboard から
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Instagram Graph API ---
# Instagram Business アカウントの ID
IG_USER_ID=your_instagram_business_account_id
# 長期（60日）アクセストークン
META_ACCESS_TOKEN=your_long_lived_access_token

# --- Unsplash (auto source) ---
# https://unsplash.com/oauth/applications で発行する Access Key
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
# カンマ区切り検索ワード（日英OK）
UNSPLASH_QUERIES=hokkaido,biei,otaru,shiretoko,sapporo,furano,hakodate,niseko,北海道,美瑛,小樽
# 1クエリあたりの取得件数（Gemini無料枠は20/日なので控えめに）
UNSPLASH_PER_QUERY=2
# "latest" で新着順 / "relevant" で関連度順
UNSPLASH_ORDER_BY=relevant
# 1 回の auto_source で Approved 投入する最大件数
AUTO_SOURCE_MAX_APPROVE=3
# 1 回の auto_source での最大採点数（LLM無料枠保護）
AUTO_SOURCE_MAX_EVAL=15

# --- 投稿設定 ---
DEFAULT_HASHTAGS=#hokkaido #北海道 #beautifulhokkaido #japan #japantravel #visitjapan #explorejapan #hokkaidotrip
TIMEZONE=Asia/Tokyo
